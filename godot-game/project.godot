[application]
config/name="Street Sovereign 3D: Hamza"
run/main_scene="res://main.tscn"
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025,0.035,0.06,1)

[physics]
3d/default_gravity=18.0

[input]
forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
fire={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1)]}
